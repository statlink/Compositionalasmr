cv.ascsmr <- function(y, x, a = seq(0.1, 1, by = 0.1), tol = 1e-6, eps = 1e-6, nfolds = 10, folds = NULL, seed = NULL) {

  if ( min(y) == 0 )  a <- abs(a)
  n <- dim(y)[1]
  ina <- 1:n
  if ( is.null(folds) )  folds <- Compositional::makefolds(ina, nfolds = nfolds, stratified = FALSE, seed = seed)
  nfolds <- length(folds)
  la <- length(a)
  js <- kl <- matrix(nrow = nfolds, ncol = la)

  runtime <- proc.time()
  for ( i in 1:nfolds ) {
    ytest <- y[ folds[[ i ]], ]  ## test set dependent vars
    ytrain <- y[ -folds[[ i ]], ]  ## train set dependent vars
    xtest <- x[ folds[[ i ]], ]  ## test set independent vars
    xtrain <- x[ -folds[[ i ]], ]  ## train set independent vars
    mod <- Compositionalscsmr::ascsmr(ytrain, xtrain, a = a, tol = tol, eps = eps, xnew = xtest)
    for ( j in 1:la ) {
      ela <- abs( ytest * log( ytest / mod[[ j ]] ) )
      ela[ is.infinite(ela) ] <- NA
      kl[i, j] <- 2 * mean(ela, na.rm = TRUE)
      ela2 <- ytest * log( 2 * ytest / (ytest + mod[[ j ]]) ) + mod[[ j ]] * log( 2 * mod[[ j ]] / (ytest + mod[[ j ]]) )
      ela2[ is.infinite(ela2) ] <- NA
      js[i, j] <- mean(ela2, na.rm = TRUE)
    }
  }
  runtime <- proc.time() - runtime

  kl <- Rfast::colmeans(kl)
  js <- Rfast::colmeans(js)
  names(kl) <- names(js) <- paste("alpha=", a, sep = "")
  list(runtime = runtime, kl = kl, js = js )
}
