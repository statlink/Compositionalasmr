scsmr <- function (y, x, xnew = NULL, tol = 1e-06, eps = 1e-6) {

  py <- dim(y)[2]   ;    px <- dim(x)[2]
  pyx <- py * px    ;    n <- dim(y)[1]
  XX <- matrix(0, pyx, pyx)
  ind <- matrix( 1:pyx, ncol = px, byrow = TRUE )
  A <- matrix(0, pyx, pyx)
  for ( i in 1:px )  A[i, ind[, i]] <- 1
  A <- t( rbind( A, diag(pyx) ) )
  A <- A[, -c( (px + 1): pyx) ]
  bvec <- c( rep(1, px), rep(0, pyx) )

  B <- .helper(y, x, XX, py, px, ind, A, bvec)
  est <- y - x %*% B
  ww <- sqrt( Rfast::rowsums(est^2) + eps^2 )
  d1 <- sum(ww)
  wx <- x / sqrt(ww)
  wy <- y / sqrt(ww)
  B <- .helper(wy, wx, XX, py, px, ind, A, bvec)
  est <- y - x %*% B
  ww <- sqrt( Rfast::rowsums(est^2) + eps^2 )
  d2 <- sum(ww)
  wx <- x / sqrt(ww)
  wy <- y / sqrt(ww)
  B <- .helper(wy, wx, XX, py, px, ind, A, bvec)

  i <- 3
  while ( abs(d2 - d1) > tol ) {
    i <- i + 1
    d1 <- d2
    est <- y - x %*% B
    ww <- sqrt( Rfast::rowsums(est^2) + eps^2 )
    d2 <- sum(ww)
    wx <- x / sqrt(ww)
    wy <- y / sqrt(ww)
    B <- .helper(wy, wx, XX, py, px, ind, A, bvec)
  }

  if ( is.null( colnames(y) ) ) {
    colnames(B) <- paste("Y", 1:dim(y)[2], sep = "")
  } else colnames(B) <- colnames(y)
  if ( is.null( colnames(x) ) ) {
    rownames(B) <- paste("X", 1:dim(x)[2], sep = "")
  } else rownames(B) <- colnames(x)

  est <- NULL
  if ( !is.null(xnew) ) {
    est <- xnew %*% B
  }

  list(iters = i, norm = d2 / dim(y)[1], be = B, est = est)
}



.helper <- function(wy, wx, XX, py, px, ind, A, bvec) {
  dvec <- as.vector( crossprod(wx, wy) )
  xx <- crossprod(wx)
  for ( k in 1:py )  XX[ ind[k, ], ind[k, ] ] <- xx
  f <- try( quadprog::solve.QP( Dmat = XX, dvec = dvec, Amat = A, bvec = bvec,
                                meq = px ), silent = TRUE )
  if ( identical(class(f), "try-error") ) {
    f <- quadprog::solve.QP( Dmat = Matrix::nearPD(XX)$mat, dvec = dvec, Amat = A, bvec = bvec, meq = px )
  }
  matrix( abs(f$solution), ncol = py)
}





