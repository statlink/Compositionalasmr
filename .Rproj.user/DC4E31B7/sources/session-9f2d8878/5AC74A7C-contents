scsmr.indeptest <- function(y, x, tol = 1e-6, eps = 1e-6, R = 999) {

  py <- dim(y)[2]   ;    px <- dim(x)[2]
  pyx <- py * px    ;    n <- dim(y)[1]
  XX <- matrix(0, pyx, pyx)
  ind <- matrix( 1:pyx, ncol = px, byrow = TRUE )
  A <- matrix(0, pyx, pyx)
  for ( i in 1:px )  A[i, ind[, i]] <- 1
  A <- t( rbind( A, diag(pyx) ) )
  A <- A[, -c( (px + 1): pyx) ]
  bvec <- c( rep(1, px), rep(0, pyx) )

  dobs <- Compositionalscsmr::scsmr(y, x, tol = tol, eps = eps)$norm

  pd <- numeric(R)
  for ( k in 1:R ) {
    id <- rangen::Sample.int(n, n)
    xb <- x[id, ]
    B <- .helper(y, xb, XX, py, px, ind, A, bvec)
    est <- y - xb %*% B
    ww <- sqrt( Rfast::rowsums(est^2) + eps^2 )
    d1 <- sum(ww)
    wx <- xb / sqrt(ww)
    wy <- y / sqrt(ww)
    B <- .helper(wy, wx, XX, py, px, ind, A, bvec)
    est <- y - xb %*% B
    ww <- sqrt( Rfast::rowsums(est^2) + eps^2 )
    d2 <- sum(ww)
    wx <- xb / sqrt(ww)
    wy <- y / sqrt(ww)
    B <- .helper(wy, wx, XX, py, px, ind, A, bvec)
    while ( abs(d2 - d1) > tol ) {
      d1 <- d2
      est <- y - xb %*% B
      ww <- sqrt( Rfast::rowsums(est^2) + eps^2 )
      d2 <- sum(ww)
      wx <- xb / sqrt(ww)
      wy <- y / sqrt(ww)
      B <- .helper(wy, wx, XX, py, px, ind, A, bvec)
    }
    pd[k] <- d2

  }

  ( sum(pd / dim(y)[1] >= dobs) + 1 ) / (R + 1)
}
