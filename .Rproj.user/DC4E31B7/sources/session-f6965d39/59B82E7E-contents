ascsmr <- function(y, x, a = seq(0.1, 1, by = 0.1), tol = 1e-6, eps = 1e-6, xnew ) {

  if ( min(y) == 0 )  a <- a[a > 0]
  py <- dim(y)[2]   ;    px <- dim(x)[2]
  pyx <- py * px    ;    n <- dim(y)[1]
  XX <- matrix(0, pyx, pyx)
  ind <- matrix( 1:pyx, ncol = px, byrow = TRUE )
  A <- matrix(0, pyx, pyx)
  for ( i in 1:px )  A[i, ind[, i]] <- 1
  A <- t( rbind( A, diag(pyx) ) )
  A <- A[, -c( (px + 1): pyx) ]
  bvec <- c( rep(1, px), rep(0, pyx) )

  res <- list()
  for ( j in 1:length(a) ) {
    ya <- y^a[j]
    ya <- ya / Rfast::rowsums(ya)

    B <- .helper(ya, x, XX, py, px, ind, A, bvec)
    est <- ya - x %*% B
    ww <- sqrt( Rfast::rowsums(est^2) + eps^2 )
    d1 <- sum(ww)
    wx <- x / sqrt(ww)
    wy <- ya / sqrt(ww) 
    B <- .helper(wy, wx, XX, py, px, ind, A, bvec)
    est <- ya - x %*% B
    ww <- sqrt( Rfast::rowsums(est^2) + eps^2 )
    d2 <- sum(ww)
    wx <- x / sqrt(ww)
    wy <- ya / sqrt(ww)
    B <- .helper(wy, wx, XX, py, px, ind, A, bvec)
    while ( abs(d2 - d1) > tol ) {
      d1 <- d2
      est <- ya - x %*% B
      ww <- sqrt( Rfast::rowsums(est^2) + eps^2 )
      d2 <- sum(ww)
      wx <- x / sqrt(ww)
      wy <- ya / sqrt(ww)
      B <- .helper(wy, wx, XX, py, px, ind, A, bvec)
    }
    
    est <- ( xnew %*% B )^( 1/a[j] )
    est <- est / Rfast::rowsums(est)
    res[[ j ]] <- est
  }

  res
}

